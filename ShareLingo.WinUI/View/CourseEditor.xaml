<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShareLingo.WinUI.View.CourseEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ShareLingo.WinUI.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ShareLingo.Core.ViewModel"
    xmlns:res="using:ShareLingo.Core.Resources"
    xmlns:glob="using:System.Globalization"
    mc:Ignorable="d"
    Background="Transparent"
    d:DataContext="{d:DesignInstance vm:CourseEditorViewModel, IsDesignTimeCreatable=False}">
    <Grid MinWidth="280" MaxWidth="360" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Grid.ColumnSpan" Value="3"/>
            </Style>
            <Style x:Key="CultureCombobox" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Grid.ColumnSpan" Value="3"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate x:DataType="glob:CultureInfo">
                            <TextBlock Text="{Binding DisplayName, Mode=OneTime}"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBox Grid.Row="0" Header="{x:Bind res:Content.courseEditor_courseNameHeader}" 
                 Text="{Binding CourseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="{Binding MaxCourseNameLength, Mode=OneTime}"/>
        <TextBox Grid.Row="1" Header="{x:Bind res:Content.courseEditor_courseAuthorHeader}"
                 Text="{Binding AutrhorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="{Binding MaxAuthorNameLength, Mode=OneTime}"/>        
        <ComboBox Grid.Row="2" Header="{x:Bind res:Content.courseEditor_courseNativeLanguageHeader}"
                  SelectedItem="{Binding SelectedNativeCulture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  Style="{StaticResource CultureCombobox}"
                  ItemsSource="{Binding Cultures, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
        <ComboBox Grid.Row="3" Header="{x:Bind res:Content.courseEditor_courseForeignLanguageHeader}"
                  SelectedItem="{Binding SelectedForeignCulture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  Style="{StaticResource CultureCombobox}"
                  ItemsSource="{Binding Cultures, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox Grid.Row="4" Grid.ColumnSpan="1" Header="{x:Bind res:Content.courseEditor_courseDocumentHeader}"
                 Text="{Binding Course.Description.Name, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="True"/>
        <Button Grid.Row="4" Grid.Column="1" Margin="6,20,0,0" Height="33" Command="{Binding DeleteDocumentCommand}">
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8BB;" FontSize="10"/>
        </Button>
        <Button Grid.Row="4" Grid.Column="2" Margin="6,20,0,0" Height="33" Command="{Binding ImportDocumentCommand}">
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8E5;" FontSize="15"/>
        </Button>
        <TextBox Grid.Row="5" Grid.ColumnSpan="1" Header="{x:Bind res:Content.courseEditor_courseCoverHeader}"
                 Text="{Binding Course.Cover.Name, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="True"/>
        <Button Grid.Row="5" Grid.Column="1" Margin="6,20,0,0" Height="33" Command="{Binding DeleteCoverCommand}">
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8BB;" FontSize="10"/>
        </Button>
        <Button Grid.Row="5" Grid.Column="2" Margin="6,20,0,0" Height="33" Command="{Binding ImportCoverCommand}">
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8E5;" FontSize="15"/>
        </Button>
        <InfoBar Grid.Row="6" Grid.ColumnSpan="3" IsOpen="{Binding InfoBarOpened, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                 Message="{Binding InfoBarMessage, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                 Severity="Error" IsClosable="False"/>
        <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button MinWidth="90" Content="{x:Bind res:Content.courseBrowser_saveButtonText}" Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding SaveCommand}"/>
            <Button MinWidth="90" Margin="6,0,0,0" Content="{x:Bind res:Content.courseBrowser_cancelButtonText}"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Page>
