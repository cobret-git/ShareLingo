<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShareLingo.WinUI.View.CourseInspectorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ShareLingo.WinUI.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ShareLingo.WinUI.ViewModel"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    d:DataContext="{d:DesignInstance vm:CourseInspectorViewModel, IsDesignTimeCreatable=False}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Vertical">
                <Border Grid.Row="0" Width="180" Height="180" CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#ff1b6b" Offset="0.0" />
                            <GradientStop Color="#45caff" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Viewbox Grid.Row="0" Width="80">
                        <SymbolIcon Symbol="Pictures" Opacity="0.6"/>
                    </Viewbox>
                </Border>

                <Button HorizontalAlignment="Stretch" Margin="0,7,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16">
                            <SymbolIcon Symbol="Document"/>
                        </Viewbox>
                        <TextBlock Margin="5,0,0,0" Text="Document"/>
                    </StackPanel>
                </Button>

                <Button HorizontalAlignment="Stretch" Margin="0,7,0,0" Style="{StaticResource AccentButtonStyle}" >
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14">
                            <SymbolIcon Symbol="Play"/>
                        </Viewbox>
                        <TextBlock Margin="5,0,0,0" Text="Run"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="16,0,0,0">
                <TextBlock Text="{Binding Course.Name, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource TitleLargeTextBlockStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Background="Transparent" BorderBrush="Transparent">
                        <SymbolIcon Symbol="Share"/>
                    </Button>
                    <Button Background="Transparent" BorderBrush="Transparent">
                        <SymbolIcon Symbol="Edit"/>
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding Course.Description, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
