<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShareLingo.WinUI.View.CourseBrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ShareLingo.WinUI.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ShareLingo.WinUI.ViewModel"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    mc:Ignorable="d"
    Background="Transparent"
    d:DataContext="{d:DesignInstance vm:CourseBrowserViewModel, IsDesignTimeCreatable=False}">
    <Page.Resources>
        <Style x:Key="CourseAddButton" TargetType="Button">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
    </Page.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Style="{StaticResource CourseAddButton}" Command="{Binding CreateCourseCommand}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Viewbox Grid.Row="0" Width="50">
                        <SymbolIcon Symbol="Add" Opacity="0.6"/>
                    </Viewbox>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0" 
                               FontWeight="Medium" Opacity="0.6"
                               Text="Add"/>
                </Grid>
            </Button>
            <Button Margin="7,0,0,0" Style="{StaticResource CourseAddButton}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Viewbox Grid.Row="0" Width="50">
                        <SymbolIcon Symbol="Download" Opacity="0.6"/>
                    </Viewbox>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0" 
                               FontWeight="Medium" Opacity="0.6" Text="Import"/>
                </Grid>
            </Button>
        </StackPanel>

        <ItemsView Grid.Row="1" SelectionMode="Single" Margin="0,10,0,0" x:Name="CourseItemsView"
                   ItemsSource="{Binding Items, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" >
            <i:Interaction.Behaviors>
                <i:EventTriggerBehavior EventName="Loaded">
                    <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
                </i:EventTriggerBehavior>
                <i:EventTriggerBehavior EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding OpenCourseCommand}" 
                                           CommandParameter="{Binding ElementName=CourseItemsView, Path=SelectedItem, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
                </i:EventTriggerBehavior>
            </i:Interaction.Behaviors>
            <ItemsView.Layout>
                <LinedFlowLayout ItemsStretch="Fill" LineSpacing="5" MinItemSpacing="5"/>
            </ItemsView.Layout>
            <ItemsView.ItemTemplate>
                <DataTemplate x:DataType="vm:CourseContainerViewModel">
                    <ItemContainer HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="10">
                        <local:CourseItemView DataContext="{Binding}"/>
                    </ItemContainer>
                </DataTemplate>
            </ItemsView.ItemTemplate>
        </ItemsView>
    </Grid>
</Page>
