<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShareLingo.WinUI.View.CourseBrowser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ShareLingo.WinUI.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ShareLingo.Core.ViewModel"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    mc:Ignorable="d"
    Background="Transparent"
    d:DataContext="{d:DesignInstance vm:CourseBrowserViewModel, IsDesignTimeCreatable=False}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Add your courses" Grid.Row="0" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Width="160" Height="160" Margin="0,0,10,0" Command="{Binding CreateCourseCommand}">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;" FontWeight="Black" FontSize="48" Opacity="0.7"/>
                </Button>
                <Button Width="160" Height="160">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE896;" FontWeight="Black" FontSize="48" Opacity="0.7"/>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Your courses" Grid.Row="0" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <ItemsView x:Name="CourseItemsView" Grid.Row="1" Margin="0,10,0,0"
                       ItemsSource="{Binding Courses, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                <interactivity:Interaction.Behaviors>
                    <interactivity:EventTriggerBehavior EventName="SelectionChanged">
                        <interactivity:InvokeCommandAction Command="{Binding OpenCourseCommand}" 
                                                           CommandParameter="{Binding ElementName=CourseItemsView, Path=SelectedItem, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </interactivity:EventTriggerBehavior>
                </interactivity:Interaction.Behaviors>
                <ItemsView.Layout>
                    <LinedFlowLayout ItemsStretch="Fill" LineHeight="194" LineSpacing="5" MinItemSpacing="5"/>
                </ItemsView.Layout>
                <ItemsView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CourseContainerViewModel">
                        <ItemContainer>
                            <Grid RowSpacing="5" Margin="4">
                                
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="160"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="160" CornerRadius="7" BorderThickness="1"
                                        Background="{StaticResource AcrylicBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{StaticResource ControlStrokeColorDefaultBrush}">
                                    <Viewbox Width="64">
                                        <SymbolIcon Symbol="Document" Opacity="0.5"/>
                                    </Viewbox>
                                </Border>
                                <Button x:Name="MoreButton" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0" CornerRadius="14" Margin="5"
                                        Background="Transparent" BorderBrush="Transparent">
                                    <SymbolIcon Symbol="More"/>
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <MenuFlyoutItem Text="Open"/>
                                            <MenuFlyoutItem Text="Export"/>
                                            <MenuFlyoutItem Text="Edit"/>
                                            <MenuFlyoutItem Text="Delete"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock Grid.Row="1" Margin="1,0,0,0"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="{Binding Item.Name, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            
                        </ItemContainer>
                    </DataTemplate>
                </ItemsView.ItemTemplate>
            </ItemsView>
        </Grid>
        
    </Grid>
</Page>
