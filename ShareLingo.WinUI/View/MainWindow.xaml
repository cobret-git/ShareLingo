<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ShareLingo.WinUI.View.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ShareLingo.WinUI.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MainWindow">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!--UIElement set as titlebar-->
        <Border x:Name="AppTitleBar" Grid.Row="0" Grid.Column="1" VerticalAlignment="Top">
            <TextBlock x:Name="AppTitle" Text="Share Lingo" VerticalAlignment="Top" Margin="0,8,0,0" />
        </Border>
        
        <NavigationView x:Name="nvSample" Loaded="nvSample_Loaded" IsSettingsVisible="False" Grid.Row="1"
                        AlwaysShowHeader="False" IsBackButtonVisible="Collapsed" IsTitleBarAutoPaddingEnabled="True">
            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Home" Content="Home" Tag="View.CourseBrowser" />
            </NavigationView.MenuItems>
            <Border>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <BreadcrumbBar Grid.Row="0" ItemClicked="BreadcrumbBar_ItemClicked" Margin="10" VerticalContentAlignment="Center" VerticalAlignment="Center"
                                   ItemsSource="{Binding BreadcrumbItems, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                        <BreadcrumbBar.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Header, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource TitleTextBlockStyle}"/>
                            </DataTemplate>
                        </BreadcrumbBar.ItemTemplate>
                    </BreadcrumbBar>
                    <Frame Grid.Row="1" x:Name="contentFrame" Background="{x:Null}" Padding="10"/>
                </Grid>
            </Border>
        </NavigationView>
    </Grid>
</Window>
