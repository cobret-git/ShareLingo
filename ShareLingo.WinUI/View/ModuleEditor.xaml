<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShareLingo.WinUI.View.ModuleEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ShareLingo.WinUI.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ShareLingo.Core.ViewModel"
    xmlns:res="using:ShareLingo.Core.Resources"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:ModuleEditorViewModel, IsDesignTimeCreatable=False}">
    <Grid HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="870"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" PlaceholderText="{x:Bind res:Content.moduleEditor_namePlaceholderText}"
                         MaxLength="{Binding MaxModuleNameLength, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                         Text="{Binding ModuleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Bind res:Content.moduleEditor_nameHeader}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind res:Content.moduleEditor_nameHintText}" Margin="0,6,0,0" Style="{StaticResource EditorHintTextBlockStyle}"/>
                        </StackPanel>
                    </TextBox.Header>
                </TextBox>

                <TextBox Grid.Row="1" PlaceholderText="0" Margin="0,36,0,0"
                         Text="{Binding ModuleIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Bind res:Content.moduleEditor_indexHeader}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind res:Content.moduleEditor_indexHintText}" Margin="0,6,0,0" Style="{StaticResource EditorHintTextBlockStyle}"/>
                        </StackPanel>
                    </TextBox.Header>
                </TextBox>

                <Grid Grid.Row="2" Margin="0,36,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Bind res:Content.moduleEditor_coverHeader}" 
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind res:Content.moduleEditor_coverHintText}" 
                               Margin="0,6,0,0" Style="{StaticResource EditorHintTextBlockStyle}"/>

                    <Grid Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                        <Border Grid.Row="0" Height="160" Width="160" CornerRadius="7" BorderThickness="1"
                                Background="{StaticResource AcrylicBackgroundFillColorDefaultBrush}"
                                BorderBrush="{StaticResource ControlStrokeColorDefaultBrush}">
                            <Viewbox Width="64">
                                <FontIcon Glyph="&#xEA86;" FontFamily="Segoe MDL2 Assets"/>
                            </Viewbox>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,12,0,0">
                        <Button Command="{Binding ImportCoverCommand}" MinWidth="110">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="15">
                                    <SymbolIcon Symbol="OpenFile" Foreground="{StaticResource AccentAAFillColorDefaultBrush}"/>
                                </Viewbox>
                                <TextBlock Text="{x:Bind res:Content.moduleEditor_importCovertButtonText}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteCoverCommand}" Margin="0,6,0,0" MinWidth="110"
                                Visibility="{Binding CanDeleteCover, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Content="{x:Bind res:Content.moduleEditor_deleteCoverButtonText}">
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" Margin="0,36,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Bind res:Content.moduleEditor_theoryHeader}" 
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind res:Content.moduleEditor_coverHintText}"
                               Margin="0,6,0,0" Style="{StaticResource EditorHintTextBlockStyle}"/>

                    <Border Grid.Row="2" Margin="0,12,0,0" BorderThickness="1" CornerRadius="6,6,0,0"
                            Background="{StaticResource AcrylicBackgroundFillColorDefaultBrush}"
                            BorderBrush="{StaticResource ControlStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Command="{Binding ImportDocumentCommand}" Background="Transparent" BorderBrush="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="15">
                                                <SymbolIcon Symbol="OpenFile" Foreground="{StaticResource AccentAAFillColorDefaultBrush}"/>
                                            </Viewbox>
                                            <TextBlock Text="{x:Bind res:Content.moduleEditor_importDocumentButtonText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DeleteDocumentCommand}" Background="Transparent" BorderBrush="Transparent" Margin="8,0,0,0"
                                            Content="{x:Bind res:Content.moduleEditor_deleteDocumentButtonText}"/>
                                </StackPanel>
                            </Border>
                            <controls:MarkdownTextBlock Grid.Row="1" BorderThickness="1,0,1,1" MinHeight="160"
                                    Text="{Binding TheoryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>
                </Grid>

                <InfoBar Grid.Row="4" IsOpen="{Binding InfoBarOpened, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                         Message="{Binding InfoBarMessage, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                         Severity="Error" IsClosable="False" Margin="0,18"/>

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{x:Bind res:Content.generalContent_saveButtonText}" MinWidth="100"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource AccentButtonStyle}"/>
                    <Button Content="{x:Bind res:Content.generalContent_cancelButtonText}" MinWidth="100" Margin="12,0,0,0"
                            Command="{Binding CancelCommand}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Column="1" Width="280" MinHeight="340" BorderThickness="1" CornerRadius="6"
                VerticalAlignment="Top" HorizontalAlignment="Left" Margin="60,0,0,0"
                BorderBrush="{StaticResource ControlStrokeColorDefaultBrush}"
                Background="{StaticResource AcrylicBackgroundFillColorDefaultBrush}">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{x:Bind res:Content.modulesEditor_generalHintHeader}" Margin="8,8,0,0" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock Text="{x:Bind res:Content.moduleEditor_generalHintText}" Margin="8,6,8,0"
                           Style="{StaticResource EditorHintTextBlockStyle}"/>
                <Expander Margin="0,14,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" Expanding="Expander_Expanding">
                    <Expander.Header>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}">
                            <Run Text="1."/>
                            <Run Text="{x:Bind res:Content.moduleEditor_nameHeader}"/>
                        </TextBlock>
                    </Expander.Header>
                    <Expander.Content>
                        <TextBlock Text="{x:Bind res:Content.moduleEditor_nameExtraHintText}" Style="{StaticResource EditorHintTextBlockStyle}"/>
                    </Expander.Content>
                </Expander>
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" Expanding="Expander_Expanding">
                    <Expander.Header>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}">
                            <Run Text="2."/>
                            <Run Text="{x:Bind res:Content.moduleEditor_indexHeader}"/>
                        </TextBlock>
                    </Expander.Header>
                    <Expander.Content>
                        <TextBlock Text="{x:Bind res:Content.moduleEditor_indexExtraHintText}" Style="{StaticResource EditorHintTextBlockStyle}"/>
                    </Expander.Content>
                </Expander>
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" Expanding="Expander_Expanding">
                    <Expander.Header>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}">
                            <Run Text="3."/>
                            <Run Text="{x:Bind res:Content.moduleEditor_coverHeader}"/>
                        </TextBlock>
                    </Expander.Header>
                    <Expander.Content>
                        <TextBlock Text="{x:Bind res:Content.moduleEditor_coverExtraHintText}" Style="{StaticResource EditorHintTextBlockStyle}"/>
                    </Expander.Content>
                </Expander>
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" Expanding="Expander_Expanding">
                    <Expander.Header>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}">
                            <Run Text="4."/>
                            <Run Text="{x:Bind res:Content.moduleEditor_theoryHeader}"/>
                        </TextBlock>
                    </Expander.Header>
                    <Expander.Content>
                        <TextBlock Text="{x:Bind res:Content.moduleEditor_theoryExtraHintText}" Style="{StaticResource EditorHintTextBlockStyle}"/>
                    </Expander.Content>
                </Expander>
            </StackPanel>
        </Border>
    </Grid>
    
</Page>
