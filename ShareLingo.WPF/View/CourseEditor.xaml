<UserControl x:Class="ShareLingo.WPF.View.CourseEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ShareLingo.WPF.View"
             xmlns:res="clr-namespace:ShareLingo.Core.Resources;assembly=ShareLingo.Core"
             xmlns:vm="clr-namespace:ShareLingo.Core.ViewModel;assembly=ShareLingo.Core"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:CourseEditorViewModel, IsDesignTimeCreatable=False}">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageH2TextBlockStyle}" Text="{x:Static res:Content.courseEditor_header}"/>

        <Label Grid.Row="1" Style="{StaticResource EditTextBoxLabelStyle}" Content="{x:Static res:Content.courseEditor_courseNameHeader}"/>
        <TextBox Grid.Row="2" Style="{StaticResource EditorTextBoxStyle}"/>
        <!--<StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,12">
            <TextBlock Text="{x:Static res:Content.courseEditor_courseNameHeader}" 
                       Style="{StaticResource MaterialBodyMedium}"
                       Height="32"/>
            <TextBox d:Text="asd" Style="{StaticResource MaterialTextBoxStyle}">
            </TextBox>
        </StackPanel>-->
    </Grid>
</UserControl>
