<UserControl x:Class="ShareLingo.WPF.View.CourseBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ShareLingo.WPF.View"
             xmlns:res="clr-namespace:ShareLingo.Core.Resources;assembly=ShareLingo.Core"
             xmlns:vm="clr-namespace:ShareLingo.Core.ViewModel;assembly=ShareLingo.Core"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:CourseBrowserViewModel, IsDesignTimeCreatable=False}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource PageH2TextBlockStyle}" Text="{x:Static res:Content.courseBrowser_addCoursesLabel}"/>

                <WrapPanel Grid.Row="1" Margin="0,24,0,0">
                    <Button Command="{Binding CreateCourseCommand}" Style="{StaticResource AddCourseModuleButtonStyle}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource AddCourseModuleIconStyle}" Template="{StaticResource AddCourseIcon}"/>
                            <TextBlock Style="{StaticResource AddCourseModuleTextStyle}" Text="{x:Static res:Content.courseBrowser_createCourseButtonText}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AddCourseModuleButtonStyle}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource AddCourseModuleIconStyle}" Template="{StaticResource ImportCourseIcon}"/>
                            <TextBlock Style="{StaticResource AddCourseModuleTextStyle}" Text="{x:Static res:Content.courseBrowser_importCourseButtonText}"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
